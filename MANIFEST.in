include README.md LICENSE THIRD_PARTY.md CITATION.cff environment.yml config.yaml .env.example main.py
recursive-include examples *.py
recursive-include tests *.py *.cjs *.txt
recursive-include mrcat *.py *.md *.R *.js *.css *.html *.svg *.txt *.ico *.png
recursive-include skills *.py *.md *.R *.json *.yaml *.txt
recursive-include scripts *.R
prune docs
include docs/architecture.md docs/skills.md docs/data.md docs/checkpoint_storage.md docs/multi_user.md docs/trace.md docs/custom_codeact.md docs/executor_transport.md docs/result_refs.md docs/final_result_delivery.md
prune skills/mr-grip/execution
prune skills/mr-grip/tests
exclude skills/mr-grip/build_contract.json
exclude skills/mr-grip/build_validation.json
exclude skills/mr-bwmr/scripts/bwmr/BWMR_updated.R
prune environments
global-exclude __pycache__ *.pyc Rplots.pdf .env .env.* *.pem *[Aa][Uu][Dd][Ii][Tt]*
include .env.example
