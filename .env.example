# Main provider: anthropic, openai, deepseek, qwen, glm, grok, custom
LLM_PROVIDER=anthropic
# Explicit transport; failures do not switch between SDK and HTTP.
LLM_BACKEND=sdk
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6

# Fill only the providers you use.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
GLM_API_KEY=
GLM_MODEL=glm-4-plus
GROK_API_KEY=
GROK_MODEL=grok-2-latest
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# Optional provider-specific *_BASE_URL, *_TIMEOUT_SEC, *_RETRY_COUNT.
# Optional generic fallbacks: LLM_API_KEY, LLM_BASE_URL, LLM_MODEL.
# Reporter inherits the main model unless explicitly overridden.
REPORTER_MODEL=
# Custom coding inherits the main provider unless explicitly overridden.
MRCAT_CODING_AGENT_PROVIDER=
# Hosted search defaults to deepseek and can fall back to openai.
SEARCH_PROVIDER=deepseek

# Match the actual served model's context and output capacities.
MRCAT_CONTEXT_TOKENS=131072
MRCAT_MODEL_CONTEXT_TOKENS={}
MRCAT_MAX_OUTPUT_TOKENS=32768
MRCAT_MAX_RETRY_OUTPUT_TOKENS=65536
MRCAT_MAX_ROUNDS=300
MRCAT_EXECUTION_TIMEOUT=3600

# Optional locations. Blank values use the documented defaults.
MRCAT_DATABASE_DIR=
MRCAT_CHECKPOINT_DIR=
MRCAT_BWMR_SOURCE=
# MRCAT_CONFIG_DIR selects the directory containing .env and config.yaml;
# export it before launching if configuration is outside the current directory.

# Optional GWAS and literature credentials.
IEU_ACCESS_TOKEN=
NCBI_EMAIL=
NCBI_API_KEY=

# Project statements used by scientific reports. Blank means not supplied.
MRCAT_PREREGISTRATION_STATUS=
MRCAT_PREREGISTRATION_STATEMENT=
MRCAT_FUNDING_STATEMENT=
MRCAT_FUNDER_ROLE_STATEMENT=
MRCAT_DATA_CODE_STATEMENT=
MRCAT_CONFLICTS_STATEMENT=
