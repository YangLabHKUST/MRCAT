## MRCAT LLM gateway
## Local mode is for the server owner's localhost console only.
## For a Cloudflare Access deployment, set MRCAT_AUTH_MODE=cloudflare and both values below.
MRCAT_AUTH_MODE=local
MRCAT_ACCESS_TEAM_DOMAIN=
MRCAT_ACCESS_AUD=

## Supported providers: anthropic, openai, deepseek, qwen, glm, grok, custom
LLM_PROVIDER=anthropic
LLM_BACKEND=sdk

## All MRCAT roles, for any selected model. Match your upstream output limit.
MRCAT_MAX_OUTPUT_TOKENS=32768
## One truncation retry doubles the initial budget up to this cap.
MRCAT_MAX_RETRY_OUTPUT_TOKENS=65536

## Whole model context capacity, including input and output; match your served model.
MRCAT_CONTEXT_TOKENS=131072
## Optional per-model capacities, e.g. {"my-model": 262144}.
MRCAT_MODEL_CONTEXT_TOKENS={}
## Execution decisions per user turn, shared across items. A continuation renews it.
MRCAT_MAX_ROUNDS=300

## Anthropic native Messages API
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-opus-4-6
ANTHROPIC_TIMEOUT_SEC=1200
ANTHROPIC_RETRY_COUNT=3

## Optional official Anthropic profile for search tests
ANTHROPIC_OFFICIAL_API_KEY=
ANTHROPIC_OFFICIAL_BASE_URL=https://api.anthropic.com
ANTHROPIC_OFFICIAL_MODEL=claude-opus-4-8

## OpenAI-compatible providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

## Optional official OpenAI profile for search tests
OPENAI_OFFICIAL_API_KEY=
OPENAI_OFFICIAL_BASE_URL=https://api.openai.com/v1
OPENAI_OFFICIAL_MODEL=gpt-5.5

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-plus

GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest

CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

## Optional generic fallback values
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

## Optional role-specific model overrides
MANAGER_MODEL=
REPORTER_MODEL=
UP_MODEL=
MAIN_MODEL=
DOWN_MODEL=
RUNNER_MODEL=
CODE_RUNNER_MODEL=

## Optional NCBI identity and API key for PubMed E-utilities
NCBI_EMAIL=
NCBI_API_KEY=

## Project-level statements appended to every STROBE-MR scientific report.
## Leave blank to use an explicit "information was not supplied" disclosure.
MRCAT_PREREGISTRATION_STATUS=
MRCAT_PREREGISTRATION_STATEMENT=
MRCAT_FUNDING_STATEMENT=
MRCAT_FUNDER_ROLE_STATEMENT=
MRCAT_DATA_CODE_STATEMENT=
MRCAT_CONFLICTS_STATEMENT=

## Optional locations outside the installed package
# MRCAT_CONFIG_DIR=/path/to/configuration
# MRCAT_DATABASE_DIR=/path/to/database
# MRCAT_DISABLE_PROXY=1
